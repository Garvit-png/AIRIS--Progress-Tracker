# ============================================================
# AIRIS — Frontend Environment Variables (Vite)
# Copy this file to .env and fill in your values.
# All client-side vars MUST be prefixed with VITE_
# ============================================================

# Backend API base URL (no trailing slash, must end with /api)
# Dev  → http://localhost:5002/api
# Prod → https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5002/api

# Google OAuth Client ID
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
