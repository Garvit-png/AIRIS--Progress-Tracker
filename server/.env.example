# ============================================================
# AIRIS — Backend Environment Variables (Express / Node)
# Copy this file to server/.env and fill in your values.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5002

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: atlas.mongodb.com → your cluster → Connect → Drivers
# IMPORTANT: Whitelist IP 0.0.0.0/0 in Atlas → Network Access
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/airis?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# ── Google OAuth ──────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── CORS — Frontend Origin ────────────────────────────────────
# Local dev → http://localhost:5173
# Production → https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ── Email (Nodemailer via Gmail) ──────────────────────────────
# Enable 2-Step Verification → create App Password at myaccount.google.com
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ── GitHub Personal Access Token ─────────────────────────────
# github.com → Settings → Developer Settings → Personal Access Tokens
# Scopes: repo (read-only)
GITHUB_PAT=github_pat_your_token_here

# ── Upstash Redis (optional — GitHub stats cache) ────────────
# upstash.com → Redis → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── File Storage (optional overrides) ────────────────────────
# UPLOADS_DIR=/absolute/path/to/uploads
# DATA_DIR=/absolute/path/to/data
