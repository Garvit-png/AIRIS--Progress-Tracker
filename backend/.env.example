# ============================================================
# AIRIS — Backend Environment Variables (Express / Node)
# Copy this file to backend/.env and fill in your values.
# ============================================================

NODE_ENV=development
PORT=5002

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/airis?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

CLIENT_URL=http://localhost:5173

GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

GITHUB_PAT=github_pat_your_token_here

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# UPLOADS_DIR=/absolute/path/to/uploads
# DATA_DIR=/absolute/path/to/data
